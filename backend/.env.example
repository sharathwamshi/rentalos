# --- Core ---
FLASK_ENV=production
SECRET_KEY=change-this-super-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rental_saas
DB_USER=rental_user
DB_PASSWORD=

# --- Frontend origin (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- App base URL (used in links sent via SMS/WhatsApp/Telegram/email) ---
APP_BASE_URL=https://rsquaretek.co.in/rental

# NOTE: Twilio / WhatsApp / Telegram / Razorpay credentials are NOT stored here.
# They are configured at runtime by the Super Admin from Admin > Settings
# and persisted (encrypted) in the app_settings table, so they can be
# rotated without a redeploy. These env vars are only used as fallback
# defaults on first boot / seeding.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TELEGRAM_BOT_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
